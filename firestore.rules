rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares de autenticación y roles
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isPassenger() {
      return isRole('PASAJERO');
    }

    function isDriver() {
      return isRole('CONDUCTOR');
    }

    function isAdmin() {
      return isRole('ADMIN');
    }

    // Colección: users/{uid}
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['PASAJERO', 'CONDUCTOR'];
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    // Colección: drivers/{driverId}
    match /drivers/{driverId} {
      // Todos los usuarios autenticados pueden ver conductores activos/cercanos
      allow read: if isAuthenticated();
      allow create: if isOwner(driverId)
        && request.resource.data.isApproved == false
        && request.resource.data.isSuspended == false;
      allow update: if isAdmin() || (
        isOwner(driverId)
        && request.resource.data.isApproved == resource.data.isApproved
        && request.resource.data.isSuspended == resource.data.isSuspended
      );
      allow delete: if isAdmin();
    }

    // Colección: rides/{rideId}
    match /rides/{rideId} {
      // Lectura permitida si el usuario es el pasajero, el conductor asignado o un Admin
      allow read: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin() ||
        (isDriver() && resource.data.status == 'SEARCHING')
      );

      // Pasajeros pueden crear solicitudes con su propio uid
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;

      // Actualización por Pasajero, Conductor asignado o Admin
      allow update: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (isDriver() && resource.data.status == 'SEARCHING') ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Colección: ratings/{ratingId}
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
